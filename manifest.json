{
  "manifest_version": 3,
  "name": "Google 主页 · 智能书签",
  "version": "2.0.1",
  "description": "简洁的新标签页，内置书签智能分类：首次使用按浏览器书签建分类，收藏时同时写入浏览器书签和主题分类。",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "favicon",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "src/index.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "src/assets/images/icon16.png",
    "48": "src/assets/images/icon48.png",
    "128": "src/assets/images/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/icons/*.svg",
        "src/assets/images/*.png",
        "src/assets/images/*.svg",
        "src/assets/images/*.PNG"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' chrome-extension: * data: chrome: https:; connect-src 'self' https://*.google.com https://*.githubusercontent.com https://*;"
  }
}